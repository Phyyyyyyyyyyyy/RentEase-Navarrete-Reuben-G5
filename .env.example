# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase: Project Settings > Database > Connection string (URI, Session pooler)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Supabase Storage for uploaded photos and receipts (optional; without these, uploads stay in media/).
# Storage > New bucket "media" (Public OFF), then Storage > S3: endpoint, region, and New access key.
# Set all five or none.
SUPABASE_S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=YOUR_REGION
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=media
